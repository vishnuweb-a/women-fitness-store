# ---------------------------------------------------------------------------
# FITNEX WOMEN - public frontend configuration
#
# Copy to `.env.local` and fill in. ONLY values that are safe to ship in a
# public browser bundle belong here. Anything prefixed with VITE_ is embedded
# in the built JavaScript and is readable by anyone who visits the site.
#
# NEVER add a service-role key, a Cloudinary API secret, or any other
# credential to a VITE_ variable. Those belong on a trusted server only.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable ("anon") key. Safe for the browser: access is still
# governed by Row Level Security. Format: sb_publishable_... (or a legacy JWT).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Cloudinary cloud name only - used to build public delivery URLs.
# The API key and API secret must NOT be placed here.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Environment files - secrets must never be committed.
# `.env.example` is deliberately allowed below.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Caches and temporary files
.cache/
.temp/
.tmp/
*.local
.eslintcache
coverage/

# Product image binaries. 406 scraped JPEGs (~66 MB) served from Cloudinary in
# production and kept locally only as a development fallback. The catalog source
# (src/data/products.js) and the public delivery manifest
# (src/data/cloudinary-manifest.json) ARE tracked — only the binaries are not.
public/assets/products/

# Private Cloudinary upload checkpoint: resumable upload state, not a
# deliverable. The public manifest in src/data/ carries the safe metadata.
.cloudinary-upload-checkpoint.json

# Vercel CLI local link/build state
.vercel
